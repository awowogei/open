#compdef open

_open() {
    local cache_file="${XDG_CACHE_HOME:-$HOME/.cache}/open/apps-zsh"
    local -a dirs=(
        "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
        /usr/share/applications
        /usr/local/share/applications
    )

    # Rebuild cache if missing or any source dir is newer.
    local d rebuild=0
    [[ -f $cache_file ]] || rebuild=1
    for d in $dirs; do
        [[ -d $d && $d -nt $cache_file ]] && { rebuild=1; break; }
    done
    if (( rebuild )); then
        mkdir -p "${cache_file:h}"
        local -A app_map
        local f content line stem name
        for d in $dirs; do
            [[ -d $d ]] || continue
            # Doing this with inbuilt zsh stuff seems to be much faster than
            # outsourcing it.
            for f in "$d"/*.desktop(N); do
                content="$(<"$f")"
                [[ $content == *NoDisplay=true* ]] && continue

                stem="${f:t:r}"
                name=""
                while IFS= read -r line; do
                    [[ $line == Name=* ]] && { name="${line#Name=}"; break; }
                done <<< "$content"

                # Escape colons for _describe compatibility
                app_map[$stem]="${stem//:/\\:}:${name:-$stem}"
            done
        done
        print -rl -- "${(@v)app_map}" > "$cache_file"
    fi
    local -a desktop_entries=( "${(@f)$(<$cache_file)}" )

    local context state state_descr
    local -A opt_args

    local conflicts='(-a --application -w --with -m --mimetype)'
    _arguments -S \
        $conflicts{-a,--application}'[Specify application]:target:->input' \
        $conflicts{-m,--mimetype}'[Specify mimetype]:file:_files' \
        $conflicts{-w,--with}'[Specify desktop entry]:desktop entry:->desktop' \
        '*:input:->input'

    case $state in
        desktop)
            _describe -t applications 'desktop entry' desktop_entries
            ;;
        input)
            _files
            # Fall back to mime types when no path matches and -a/-w is set.
            if (( compstate[nmatches] == 0 )) && \
               (( ${+opt_args[-a]} + ${+opt_args[--application]} + ${+opt_args[-w]} + ${+opt_args[--with]} )); then
                _mime_types
            fi
            ;;
    esac
}

_open "$@"
