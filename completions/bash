# bash completion for `open`

# Print desktop entry stems (skipping NoDisplay=true), cached.
_open_desktop_stems() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/open/apps-bash"
    local dirs=(
        "${XDG_DATA_HOME:-$HOME/.local/share}/applications"
        /usr/local/share/applications
        /usr/share/applications
    )
    local d rebuild=0
    [[ -f $cache ]] || rebuild=1
    for d in "${dirs[@]}"; do
        [[ -d $d && $d -nt $cache ]] && { rebuild=1; break; }
    done
    if (( rebuild )); then
        mkdir -p "${cache%/*}"
        for d in "${dirs[@]}"; do
            [[ -d $d ]] || continue
            for f in "$d"/*.desktop; do
                [[ -f $f ]] || continue
                grep -q 'NoDisplay=true' "$f" && continue
                f=${f##*/}
                echo "${f%.desktop}"
            done
        done | sort -u > "$cache"
    fi
    cat "$cache"
}

_open_completions() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
    local opts="-a --application -w --with -m --mimetype"
    COMPREPLY=()

    # -w/--with takes a desktop entry as its value.
    if [[ $prev == -w || $prev == --with ]]; then
        COMPREPLY=( $(compgen -W "$(_open_desktop_stems)" -- "$cur") )
        return
    fi

    # Flags. Only one of -a/-w/-m may appear; suppress further flag suggestions
    # once any is present.
    if [[ $cur == -* ]]; then
        local w
        for w in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
            case $w in -a|--application|-w|--with|-m|--mimetype) return ;; esac
        done
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return
    fi

    # Positional INPUT: paths, plus mimetypes when -a or -w is present.
    # Paths win; only fall back to mimetypes if no path matches the token.
    COMPREPLY=( $(compgen -f -- "$cur") )
    if (( ${#COMPREPLY[@]} )); then
        compopt -o filenames 2>/dev/null
        return
    fi
    local w
    for w in "${COMP_WORDS[@]}"; do
        case $w in -a|--application|-w|--with) ;; *) continue ;; esac
        for f in /etc/mime.types /usr/share/mime/types; do
            [[ -f $f ]] || continue
            # Print column 1 (the mimetype), skipping comments and blank lines.
            COMPREPLY=( $(compgen -W "$(awk '!/^#/ && NF {print $1}' "$f")" -- "$cur") )
            return
        done
        return
    done
}

complete -F _open_completions open
