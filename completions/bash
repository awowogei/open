# bash completion for `open`

_open_get_apps() {
    local cache="${XDG_CACHE_HOME:-$HOME/.cache}/open/apps"
    open update-desktop-entry-cache
    [[ -f $cache ]] || return
    # Cache format: executable_name\tprogram_name\tpath
    # Bash can't display descriptions I think so we only use the executable name
    awk -F '\t' '{print $1}' "$cache"
}

_open_completions() {
    local cur=${COMP_WORDS[COMP_CWORD]} prev=${COMP_WORDS[COMP_CWORD-1]}
    local opts="-a --application -w --with -m --mimetype"
    COMPREPLY=()

    if [[ $prev == -w || $prev == --with ]]; then
        COMPREPLY=( $(compgen -W "$(_open_get_apps)" -- "$cur") )
        return
    fi

    # Flags are exclusive
    if [[ $cur == -* ]]; then
        local w
        for w in "${COMP_WORDS[@]:1:COMP_CWORD-1}"; do
            case $w in -a|--application|-w|--with|-m|--mimetype) return ;; esac
        done
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return
    fi

    # Paths prefered, fall back to mimetypes if no path matches.
    COMPREPLY=( $(compgen -f -- "$cur") )
    if (( ${#COMPREPLY[@]} )); then
        compopt -o filenames 2>/dev/null
        return
    fi
    local w
    for w in "${COMP_WORDS[@]}"; do
        case $w in -a|--application|-w|--with) ;; *) continue ;; esac
        for f in /etc/mime.types /usr/share/mime/types; do
            [[ -f $f ]] || continue
            # Print column 1 (the mimetype), skipping comments and blank lines.
            COMPREPLY=( $(compgen -W "$(awk '!/^#/ && NF {print $1}' "$f")" -- "$cur") )
            return
        done
        return
    done
}

complete -F _open_completions open
