# fish completions for open

# Get Desktop Entry Stems + cache them
function __fish_open_get_apps
    set -l cache_dir (set -q XDG_CACHE_HOME; and echo "$XDG_CACHE_HOME"; or echo "$HOME/.cache")/open
    set -l cache_file "$cache_dir/apps-fish"
    set -l data_home (set -q XDG_DATA_HOME; and echo "$XDG_DATA_HOME"; or echo "$HOME/.local/share")
    set -l app_dirs "$data_home/applications" "/usr/share/applications" "/usr/local/share/applications"
    
    mkdir -p "$cache_dir"

    # Check if cache is valid (newer than all app directories)
    set -l use_cache 1
    if test -f "$cache_file"
        for d in $app_dirs
            if test -d "$d"; and test "$d" -nt "$cache_file"
                set use_cache 0
                break
            end
        end
    else
        set use_cache 0
    end

    if test "$use_cache" -eq 1
        cat "$cache_file"
    else
        # Rebuild cache
        set -l results
        for d in $app_dirs
            if test -d "$d"
                for f in "$d"/*.desktop
                    # Skip NoDisplay=true
                    if not grep -q "NoDisplay=true" "$f"
                        set -l stem (string replace -r '\.desktop$' '' (basename "$f"))
                        set -l name (sed -n '/^Name=/ { s/^Name=//; p; q; }' "$f")
                        set -l entry "$stem"\t"$name"
                        if not contains "$entry" $results
                            set -a results "$entry"
                        end
                    end
                end
            end
        end
        printf "%s\n" $results > "$cache_file"
        printf "%s\n" $results
    end
end

# Prefers matching file paths. Only falls back to mimetypes (from the first
# available system mime list) when there are no matching paths for the token.
function __fish_open_paths_or_mimes
    set -l token (commandline -ct)
    set -l paths (__fish_complete_path $token)
    if test (count $paths) -gt 0
        printf "%s\n" $paths
        return
    end
    for f in /etc/mime.types /usr/share/mime/types
        if test -f $f
            # Print column 1 (the mimetype), skipping comments and blank lines.
            awk '!/^#/ && NF {print $1}' $f
            return
        end
    end
end

# XXX: The order here is detrimental to its function. The completions with
# conditions exclude the same options from being suggested again.

# Disable file completion by default so we can control it via logic.
complete -c open -f

# Free arguments
# After -w <app> or -a <input>, additional INPUTs are paths or mimetypes.
complete -c open -n "__fish_seen_argument -s w -l with -s a -l application" -a "(__fish_open_paths_or_mimes)"
# After -m <input>, additional INPUTs are paths only.
complete -c open -n "__fish_seen_argument -s m -l mimetype" -a "(__fish_complete_path)"

# -a / --application: next token is a file path, or a mimetype as fallback
complete -c open -o a -l application -r -a "(__fish_open_paths_or_mimes)"

# -m / --mimetype: next token is a path
complete -c open -o m -l mimetype -r -a "(__fish_complete_path)"

# -w / --with: next token is a desktop entry
complete -c open -o w -l with -r -a "(__fish_open_get_apps)"

# Else, paths only.
complete -c open -n "not __fish_seen_argument -a --application -w --with -m --mimetype" -a "(__fish_complete_path)"
