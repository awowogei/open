# 1. Helper: Get MimeTypes (since Fish lacks _mime_types)
function __fish_open_get_mimetypes
    # Common locations for mime.types
    for file in /etc/mime.types /usr/share/mime/types
        if test -f $file
            # Parse the first column, skip comments/empty lines
            sed -e 's/#.*//' -e '/^[[:space:]]*$/d' $file | awk '{print $1}'
            return
        end
    end
end

# 2. Helper: Get Desktop Entry Stems with Caching and Validation
function __fish_open_get_apps
    set -l cache_dir (set -q XDG_CACHE_HOME; and echo "$XDG_CACHE_HOME"; or echo "$HOME/.cache")/fish_open
    set -l cache_file "$cache_dir/apps.cache"
    set -l app_dirs "$HOME/.local/share/applications" "/usr/share/applications" "/usr/local/share/applications"
    
    mkdir -p "$cache_dir"

    # Check if cache is valid (newer than all app directories)
    set -l use_cache 1
    if test -f "$cache_file"
        for d in $app_dirs
            if test -d "$d"; and test "$d" -nt "$cache_file"
                set use_cache 0
                break
            end
        end
    else
        set use_cache 0
    end

    if test "$use_cache" -eq 1
        cat "$cache_file"
    else
        # Rebuild cache
        set -l results
        for d in $app_dirs
            if test -d "$d"
                for f in "$d"/*.desktop
                    # Skip NoDisplay=true
                    if not grep -q "NoDisplay=true" "$f"
                        set -l stem (string replace -r '\.desktop$' '' (basename "$f"))
                        set -l name (sed -n '/^Name=/ { s/^Name=//; p; q; }' "$f")
                        set -l entry "$stem\t$name"
                        if not contains "$entry" $results
                            set -a results "$entry"
                        end
                    end
                end
            end
        end
        printf "%s\n" $results > "$cache_file"
        printf "%s\n" $results
    end
end

# 3. Define Logic Variables
set -l conflicts "-a --application -w --with -m --mimetype"

# 4. Command Completions
# Disable file completion by default so we can control it via logic
complete -c open -f

# -a / --application: Files + MimeTypes
complete -c open -s a -l application -n "not __fish_seen_argument -l application -l with -l mimetype -s a -s w -s m" -r -a "(__fish_complete_path)"
complete -c open -s a -l application -n "not __fish_seen_argument -l application -l with -l mimetype -s a -s w -s m" -r -a "(__fish_open_get_mimetypes)"

# -m / --mimetype: Files only
complete -c open -s m -l mimetype -n "not __fish_seen_argument -l application -l with -l mimetype -s a -s w -s m" -r -a "(__fish_complete_path)"

# -w / --with: Desktop Stems
complete -c open -s w -l with -n "not __fish_seen_argument -l application -l with -l mimetype -s a -s w -s m" -r -a "(__fish_open_get_apps)"

# 5. Free Argument Logic
# If -w or -a seen: Files + MimeTypes
complete -c open -n "__fish_seen_argument -s w -l with -s a -l application" -a "(__fish_complete_path)"
complete -c open -n "__fish_seen_argument -s w -l with -s a -l application" -a "(__fish_open_get_mimetypes)"

# If -m seen: Files only
complete -c open -n "__fish_seen_argument -s m -l mimetype" -a "(__fish_complete_path)"

# Default: Files only
complete -c open -n "not __fish_seen_argument $conflicts" -a "(__fish_complete_path)"
